# Public site URL used by Stripe Checkout redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe Test Mode keys (never expose these in client-side code)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=atipthummakul@gmail.com
# Optional: use your verified domain sender, otherwise Resend's onboarding sender is used
RESEND_FROM_EMAIL=A-Thip House <onboarding@resend.dev>

# Existing analytics storage
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ADMIN_PASSWORD_HASH=$2b$12$replace_with_bcrypt_hash
ADMIN_SESSION_SECRET=use-a-long-random-secret-here
CRON_SECRET=use-a-long-random-cron-secret-here
STRIPE_SECRET_KEY=your_stripe_test_secret_key
# Set false to disable public bookings for this deployment.
BOOKING_ENABLED=true
